{
  "name": "galactic-spacefarers",
  "version": "1.0.0",
  "description": "Galactic Spacefarers SAP CAP + Fiori application.",
  "license": "ISC",
  "author": "m-ahlstrom",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "format": "prettier --write \"{srv,db,test}/**/*.ts\"",
    "lint": "eslint --quiet",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "watch-galactic-spacefarers-app": "cds watch --open galacticspacefarersapp/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "dependencies": {
    "@cap-js/sqlite": "^3.0.2",
    "@sap/cds": "^10.0.6"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/cds-typer": ">=0.1",
    "@cap-js/cds-types": "^0.18.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tsx": "^4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "cds-plugin-ui5": "^0.17.0"
  },
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "cds": {
    "requires": {
      "auth": {
        "kind": "mocked",
        "users": {
          "alice": {
            "password": "alice",
            "roles": [
              "MissionControl"
            ],
            "attr": {
              "planet": "*"
            }
          },
          "bob": {
            "password": "bob",
            "roles": [
              "Spacefarer"
            ],
            "attr": {
              "planet": "Earth"
            }
          },
          "zork": {
            "password": "zork",
            "roles": [
              "Spacefarer"
            ],
            "attr": {
              "planet": "Mars"
            }
          }
        },
        "[production]": {
          "kind": "xsuaa"
        }
      }
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/galactic-spacefarers-app"
  ]
}
